def get_params_from_config():
    if not os.path.exists(RNODE_CONFIG): return {}
    cfg = configparser.ConfigParser(); cfg.read(RNODE_CONFIG)
    for sec in cfg.sections():
        if cfg.get(sec, 'type', fallback='').lower() == 'rnodeinterface':
            return {k: cfg.get(sec, k) for k in ['frequency','tx_power','spreading_factor','bandwidth','coding_rate']}
    return {}

def decode_payload(line):
    tm = re.search(r"'text':\s*'((?:\\.|[^'])*)'", line)
    if tm:
        txt = tm.group(1).replace('\\n', ' ').replace('\\t', ' ').strip()
        if txt and len(txt) >= 2: return txt
    for q in ["'", '"']:
        m = re.search(r"payload:\s*b" + q + r"((?:\\.|[^" + q + r"])*)", line)
        if not m: continue
        raw = m.group(1); res = bytearray(); i = 0
        while i < len(raw):
            if raw[i] == '\\' and i + 3 < len(raw) and raw[i+1] == 'x':
                try: res.append(int(raw[i+2:i+4], 16)); i += 4; continue
                except: pass
            elif raw[i] == '\\' and i + 1 < len(raw): i += 2
            else:
                if 32 <= ord(raw[i]) <= 126: res.append(ord(raw[i]))
                i += 1
        try:
            txt = res.decode('utf-8', errors='ignore').strip()
            if txt and len(txt) >= 2 and 'proto' not in txt.lower(): return txt
        except: pass
    return None

def kiss_encode(frame):
    return b'\xc0' + frame.replace(b'\xdb', b'\xdb\xdd').replace(b'\xc0', b'\xdb\xdc') + b'\xc0'

def kiss_decode(data):
    frames, buf, escape = [], b'', False
    for byte in data:
        if escape:
            buf += b'\xc0' if byte == 0xdc else b'\xdb' if byte == 0xdd else bytes([byte])
            escape = False
        elif byte == 0xdb: escape = True
        elif byte == 0xc0:
            if buf: frames.append(buf); buf = b''
        else: buf += bytes([byte])
    return frames

def is_process_running(pattern):
    try:
        result = subprocess.run(["pgrep", "-f", pattern], capture_output=True, text=True)
        return result.returncode == 0
    except:
        return False

def reader_loop():
    global seen_texts
    last_pos = os.path.getsize(DATA_FILE) if os.path.exists(DATA_FILE) else 0
    while True:
        try:
            if not os.path.exists(DATA_FILE): time.sleep(2); continue
            cur = os.path.getsize(DATA_FILE)
            if cur < last_pos: last_pos = 0
            if cur <= last_pos: time.sleep(1); continue
            with open(DATA_FILE, 'rb') as f:
                f.seek(last_pos); chunk = f.read(); last_pos = f.tell()
            for line in chunk.decode('utf-8', errors='ignore').splitlines():
                line = line.strip()
                if not line: continue
                ts = datetime.now().strftime('%H:%M')
                
                if "'longName':" in line:
                    id_search = re.search(r"'id':\s*'!?([a-f0-9]+)'", line)
                    name_search = re.search(r"'longName':\s*'([^']+)'", line)
                    
                    if id_search and name_search:
                        fid = id_search.group(1)
                        name = name_search.group(1)
                        with data_lock:
                            if fid not in data['nodes']:
                                data['nodes'][fid] = {'last_seen': ts, 'name': name, 'rssi': '', 'snr': '', 'seen_ts': time.time()}
                            else:
                                data['nodes'][fid]['name'] = name

                fid_m = re.search(r"'fromId':\s*'!?([a-f0-9]+)'", line)
                if fid_m:
                    fid = fid_m.group(1)
                    rssi_m = re.search(r"'rxRssi':\s*(-?\d+)", line)
                    snr_m = re.search(r"'rxSnr':\s*(-?\d+\.?\d*)", line)
                    bat = re.search(r"battery_level[:\s]+(\d+)", line)
                    volt = re.search(r"'voltage':\s*([\d.]+)", line)
                    
                    with data_lock:
                        if fid not in data['nodes']:
                            data['nodes'][fid] = {'last_seen': ts, 'name': '', 'rssi': '', 'snr': '', 'seen_ts': time.time()}
                        data['nodes'][fid]['last_seen'] = ts
                        data['nodes'][fid]['seen_ts'] = time.time()
                        if rssi_m: data['nodes'][fid]['rssi'] = rssi_m.group(1)
                        if snr_m: data['nodes'][fid]['snr'] = snr_m.group(1)
                        if bat: data['battery'] = f"{bat.group(1)}%"
                        if volt: data['voltage'] = f"{volt.group(1)}V"
                        data['status'] = '🟢 Online'

                text = decode_payload(line)
                if text and fid_m and len(text) >= 2:
                    key = f"{fid}:{text}"
                    if key not in seen_texts:
                        seen_texts.add(key)
                        sender = data['nodes'].get(fid, {}).get('name', fid[:6])
                        with data_lock:
                            data['messages'].insert(0, {'time': datetime.now().strftime('%H:%M:%S'), 'text': text, 'sender': sender, 'sender_id': fid})
                            if len(data['messages']) > 50: data['messages'] = data['messages'][:50]
        except Exception as e:
            with open('/home/alex/mesh_err.log', 'a') as f: f.write(f"{datetime.now()}: {e}\n")
        time.sleep(1)

def rnode_reader_loop():
    global rnode_ser
    while True:
        try:
            if not rnode_ser or not rnode_ser.is_open:
                if os.path.exists(RNODE_PORT):
                    rnode_ser = serial.Serial(RNODE_PORT, baudrate=RNODE_BAUD, timeout=1, write_timeout=1)
                    with rnode_lock: rnode_data['status'] = '🟢 Online'
                else:
                    with rnode_lock: rnode_data['status'] = '🔌 Ожидание...'
                    time.sleep(3); continue
            if rnode_ser.in_waiting:
                raw = rnode_ser.read(rnode_ser.in_waiting)
                for f in kiss_decode(raw):
                    if len(f) > 1 and f[0] == 0x00:
                        try:
                            text = f[1:].decode('utf-8', errors='ignore').strip()
                            if text and len(text) >= 2:
                                with rnode_lock:
                                    rnode_data['messages'].insert(0, {'time': datetime.now().strftime('%H:%M:%S'), 'text': text, 'sender': 'RNode'})
                                    if len(rnode_data['messages']) > 50: rnode_data['messages'] = rnode_data['messages'][:50]
                        except: pass
            time.sleep(0.05)
        except: 
            if rnode_ser: rnode_ser.close()
            time.sleep(3)

def metrics_loop():
    while True:
        try:
            r = subprocess.run([RN_PATH, '-j', '-a'], capture_output=True, text=True, timeout=10)
            if r.returncode == 0:
                jd = json.loads(r.stdout)
                with data_lock:
                    data['rnode_totals'] = {'rxb': jd.get('rxb', 0), 'txb': jd.get('txb', 0)}
                    interfaces = []
                    for i in jd.get('interfaces', []):
                        rx_kb = i.get('rxb', 0) / 1024.0
                        tx_kb = i.get('txb', 0) / 1024.0
                        interfaces.append({
                            'name': i.get('name', ''),
                            'type': i.get('type', ''),
                            'status': 'Up' if i.get('status') else 'Down',
                            'rx': f"{rx_kb:.1f}KB",
                            'tx': f"{tx_kb:.1f}KB"
                        })
                    data['rnode_interfaces'] = interfaces
                    nodes_raw = jd.get('nodes') or jd.get('destinations') or []
                    nodes_parsed = []
                    now_ts = time.time()
                    for n in nodes_raw:
                        node_id = n.get('id', n.get('hash', '?'))
                        rssi_val = n.get('rssi', n.get('signal', '?'))
                        last_seen = n.get('last_seen', '—')
                        nodes_parsed.append({
                            'id': str(node_id)[:12],
                            'rssi': rssi_val,
                            'last_seen': str(last_seen),
                            'seen_ts': n.get('seen_ts', now_ts)
                        })
                    data['rnode_nodes'] = nodes_parsed
            cfg = get_params_from_config()
            if cfg:
                with rnode_lock:
                    for k in ['frequency','tx_power','spreading_factor','bandwidth','coding_rate']:
                        if cfg.get(k): rnode_data['metrics'][k if k != 'spreading_factor' else 'sf'] = cfg[k]
        except: pass
        time.sleep(30)

def update_network_loop():
    while True:
        try:
            i={'wifi_ip':'—','vpn_ip':'—'}
            for n,k in [('wlp2s0','wifi_ip'),('tun0','vpn_ip')]:
                try:
                    a=netifaces.ifaddresses(n)
                    if netifaces.AF_INET in a: i[k]=a[netifaces.AF_INET][0]['addr']
                except:pass
            with data_lock: data['network'] = i
            try:
                r=subprocess.run(['ping','-c','1','-W','1',RNODE_HOST],capture_output=True,text=True,timeout=2)
                ms='—'
                if 'time=' in r.stdout:
                    time_part = r.stdout.split('time=')[1].split()[0]
                    ms = f"{float(time_part):.0f}ms"
                with data_lock: data['rnode'] = {'status':'online' if r.returncode==0 else 'offline','ping':ms,'last_check':datetime.now().strftime('%H:%M')}
            except: pass
        except: pass
        time.sleep(15)

@app.route('/api/sendmsg', methods=['POST'])
def send_msg():
    global cmd_in_progress
    d = request.json or {}; text = d.get('text', '').strip(); dest = d.get('dest', None)
    if not text: return jsonify({'status': 'error', 'msg': 'Пустой текст'}), 400
    if cmd_in_progress: return jsonify({'status': 'error', 'msg': 'Занято'}), 409
    cmd_in_progress = True
    try:
        subprocess.run(['pkill', '-f', 'meshtastic.*listen'], capture_output=True); time.sleep(2)
        cmd = [MESHTASTIC_BIN, '--port', '/dev/meshtastic']
        if dest:
            cmd += ['--dest', f'!{dest}', '--sendtext', text]
        else:
            cmd += ['--ch-index', '0', '--sendtext', text]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
        if r.returncode == 0: 
            return jsonify({'status': 'ok', 'msg': '✅ Отправлено'})
        else:
            err = r.stderr.strip() if r.stderr else "Unknown error"
            return jsonify({'status': 'error', 'msg': f'CLI Error: {err[:100]}'})
    except Exception as e: 
        return jsonify({'status': 'error', 'msg': str(e)})
    finally: 
        cmd_in_progress = False

@app.route('/api/rnode_msg', methods=['POST'])
def rnode_send():
    d = request.json or {}; text = d.get('text', '').strip()[:230]
    if not text: return jsonify({'status': 'error'}), 400
    try:
        ser = serial.Serial(RNODE_PORT, baudrate=RNODE_BAUD, timeout=2)
        ser.write(kiss_encode(b'\x00' + text.encode())); ser.flush(); ser.close()
        return jsonify({'status': 'ok'})
    except Exception as e: return jsonify({'status': 'error', 'msg': str(e)[:80]}), 500

@app.route('/api/rnode_mode', methods=['GET', 'POST'])
def rnode_mode_api():
    token = request.args.get('token') or (request.json.get('token') if request.is_json else '')
    if token != REBOOT_TOKEN: return jsonify({'status':'error','msg':'Access denied'}), 403
    
    if request.method == 'GET': 
        cfg = configparser.ConfigParser()
        cfg.read(RNODE_CONFIG)
        mode = 'tcp'
        for sec in cfg.sections():
            if cfg.get(sec, 'type', fallback='').lower() == 'rnodeinterface':
                mode = 'direct'
                break
        return jsonify({'current_mode': mode})
    
    # POST: Переключение режима
    d = request.json or {}
    mode = d.get('mode', '').lower()
    if mode not in ['direct', 'tcp']:
        return jsonify({'status':'error','msg':'Invalid mode'}), 400
    
    try:
        cfg = configparser.ConfigParser()
        cfg.read(RNODE_CONFIG)
        
        # Удаляем старые секции RNode/TCP
        sections_to_remove = []
        for sec in cfg.sections():
            sec_type = cfg.get(sec, 'type', fallback='').lower()
            if sec_type in ['rnodeinterface', 'tcpinterface', 'tcpclientinterface']:
                sections_to_remove.append(sec)
        for sec in sections_to_remove:
            cfg.remove_section(sec)
        
        # Добавляем новую секцию
        if mode == 'direct':
            cfg['RNode Direct'] = {
                'type': 'RNodeInterface',
                'interface_enabled': 'yes',
                'port': RNODE_PORT,
                'baudrate': str(RNODE_BAUD),
                'frequency': '868000000',
                'bandwidth': '125000',
                'spreading_factor': '7',
                'coding_rate': '5',
                'tx_power': '17'
            }
        else:  # tcp
            cfg['RNode TCP'] = {
                'type': 'TCPClientInterface',
                'interface_enabled': 'yes',
                'target_host': RNODE_HOST,
                'target_port': '4242'
            }
        
        # Сохраняем конфиг
        with open(RNODE_CONFIG, 'w') as f:
            cfg.write(f)
        
        # Перезапускаем сервис rnode-transport
        subprocess.run(['sudo', 'systemctl', 'restart', 'rnode-transport'], 
                      capture_output=True, timeout=10)
        
        return jsonify({'status':'ok','msg': f'Режим переключен на {mode.upper()}. Сервис перезапущен.'})
    
    except Exception as e:
        return jsonify({'status':'error','msg': f'Ошибка переключения: {str(e)[:100]}'}), 500

@app.route('/api/meshcmd', methods=['POST'])
def meshcmd():
    global cmd_in_progress
    token=request.args.get('token') or (request.json.get('token') if request.is_json else '')
    action=request.args.get('action') or (request.json.get('action') if request.is_json else '')
    if token!=REBOOT_TOKEN: return jsonify({'status':'error','msg':'Access denied'}), 403
    if cmd_in_progress: return jsonify({'status':'error','msg':'Busy'}), 409
    cmd_in_progress=True
    try:
        subprocess.run(['pkill','-f','meshtastic.*listen'],capture_output=True); time.sleep(2)
        if action=='reboot': r=subprocess.run([MESHTASTIC_BIN,'--port','/dev/meshtastic','--reboot'],capture_output=True,text=True,timeout=15)
        elif action=='shutdown': r=subprocess.run([MESHTASTIC_BIN,'--port','/dev/meshtastic','--shutdown'],capture_output=True,text=True,timeout=15)
        elif action=='send_location': r=subprocess.run([MESHTASTIC_BIN,'--port','/dev/meshtastic','--setlat','0','--setlon','0'],capture_output=True,text=True,timeout=15)
        elif action=='mqtt_tls_off': r=subprocess.run([MESHTASTIC_BIN,'--port','/dev/meshtastic','--set','mqtt.tls_enabled','false'],capture_output=True,text=True,timeout=15)
        return jsonify({'status':'ok','msg':'Command sent'})
    except Exception as e: return jsonify({'status':'error','msg':str(e)})
    finally: cmd_in_progress=False

def check_token():
    token = request.args.get('token') or (request.json.get('token') if request.is_json else '')
    return token == REBOOT_TOKEN

@app.route('/api/restart_or_start_mesh_service', methods=['POST'])
def restart_or_start_mesh_service():
    if not check_token():
        return jsonify({'status':'error','msg':'Access denied'}), 403
    try:
        running = is_process_running(MESHTASTIC_PATTERN)
        subprocess.run(['pkill', '-f', MESHTASTIC_PATTERN], capture_output=True)
        time.sleep(2)
        subprocess.Popen([MESHTASTIC_BIN, '--port', '/dev/meshtastic', '--listen'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        msg = 'Meshtastic перезапущен' if running else 'Meshtastic запущен'
        return jsonify({'status':'ok','msg': msg})
    except Exception as e:
        return jsonify({'status':'error','msg': str(e)})

