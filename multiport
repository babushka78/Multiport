def preload_node_names():
    print("🔄 Загрузка имен из истории...")
    if not os.path.exists(DATA_FILE): return
    count = 0
    try:
        with open(DATA_FILE, 'r', encoding='utf-8', errors='ignore') as f:
            for line in f:
                if "'longName':" in line:
                    id_m = re.search(r"'id':\s*'!?([a-f0-9]+)'", line)
                    name_m = re.search(r"'longName':\s*'([^']+)'", line)
                    if id_m and name_m:
                        fid = id_m.group(1)
                        name = name_m.group(1)
                        with data_lock:
                            if fid not in data['nodes']:
                                data['nodes'][fid] = {'last_seen': '—', 'name': name, 'rssi': '', 'snr': '', 'seen_ts': time.time()}
